# Apache / LiteSpeed config (Hostinger). Deployed with the contents of dist/.

Options -MultiViews -Indexes
DirectoryIndex index.html
DirectorySlash Off
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Force HTTPS and non-www (one canonical host)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://arviontechnologies.com%{REQUEST_URI} [L,R=301]

  # 2. Old/duplicate URLs
  RewriteRule ^contact-us/?$ /contact [L,R=301]

  # 3. /index.html -> /  and  /page.html -> /page
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?]
  RewriteRule ^ / [L,R=301]
  RewriteCond %{THE_REQUEST} \s/([^\s?]+)\.html[\s?]
  RewriteCond %1 !^404$
  RewriteRule ^ /%1 [L,R=301]

  # 4. Remove trailing slash (except root)
  RewriteRule ^(.+)/$ /$1 [L,R=301]

  # 5. Serve real files (assets, robots.txt, sitemap.xml) as-is
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 6. Serve prerendered pages: /services/payroll -> /services/payroll.html
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]

  # Anything else falls through to a real 404 (ErrorDocument above).
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

# Caching: hashed build assets (js/css/webp/avif) never change; other images 1 week; HTML always revalidates
<IfModule mod_headers.c>
  <FilesMatch "\.(png|jpe?g|svg|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(js|css|webp|avif|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
